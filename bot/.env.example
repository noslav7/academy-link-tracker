# --- Bot service configuration ---

# Telegram bot token (get from @BotFather)
TELEGRAM_TOKEN=

# Outbound requests to scrapper
SCRAPPER_BASE_URL=http://localhost:8081
SCRAPPER_TRANSPORT=HTTP
SCRAPPER_GRPC_HOST=localhost
SCRAPPER_GRPC_PORT=9091

# Kafka (прием уведомлений от scrapper)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8085/apis/registry/v2
KAFKA_TOPIC=link-updates
KAFKA_DLQ_TOPIC=link-updates-dlq
KAFKA_GROUP_ID=bot-link-updates
KAFKA_CLIENT_ID=bot
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_MS=1000

# Optional: enable bot gRPC server (for scrapper callbacks)
BOT_GRPC_SERVER_ENABLED=false
BOT_GRPC_SERVER_PORT=9090
