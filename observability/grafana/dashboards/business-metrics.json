        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (application, tracked_source) (links_on_track_total{application=~\"$application\", app_type=~\"$app_type\"})",
          "legendFormat": "{{application}} {{tracked_source}}",
          "refId": "A"
        }
      ],
      "title": "Tracked links by source domain",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "50/95/99 перцентили времени scrape-операции по источникам github и stackoverflow.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
