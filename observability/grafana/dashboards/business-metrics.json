        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (application, scope_type, le) (rate(request_duration_ms_total_bucket{application=~\"$application\", app_type=~\"$app_type\", scope=\"external_source\", scope_type=~\"github|stackoverflow\"}[5m])))",
          "legendFormat": "p50 {{application}} {{scope_type}}",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (application, scope_type, le) (rate(request_duration_ms_total_bucket{application=~\"$application\", app_type=~\"$app_type\", scope=\"external_source\", scope_type=~\"github|stackoverflow\"}[5m])))",
          "legendFormat": "p95 {{application}} {{scope_type}}",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (application, scope_type, le) (rate(request_duration_ms_total_bucket{application=~\"$application\", app_type=~\"$app_type\", scope=\"external_source\", scope_type=~\"github|stackoverflow\"}[5m])))",
          "legendFormat": "p99 {{application}} {{scope_type}}",
          "refId": "C"
        }
      ],
      "title": "Scrape duration percentiles by source",
      "type": "timeseries"
    },
