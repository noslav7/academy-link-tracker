  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "R в RED: количество HTTP-запросов в секунду по приложению и коду ответа.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{application=~\"$application\", app_type=~\"$app_type\", uri!=\"/metrics\"}[1m]))",
          "legendFormat": "{{application}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "RED: Request rate (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "E в RED: доля 5xx ответов от всех HTTP-запросов.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", app_type=~\"$app_type\", status=~\"5..\", uri!=\"/metrics\"}[5m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", app_type=~\"$app_type\", uri!=\"/metrics\"}[5m])), 1e-9)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "RED: Error rate (5xx)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "D в RED: p95 латентность HTTP-запросов.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"$application\", app_type=~\"$app_type\", uri!=\"/metrics\"}[5m])))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "RED: Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Используемая память JVM с разделением по heap/nonheap.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (application, area) (jvm_memory_used_bytes{application=~\"$application\", app_type=~\"$app_type\"})",
          "legendFormat": "{{application}} {{area}}",
          "refId": "A"
        }
      ],
      "title": "JVM memory used by area",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Память процесса: RSS и virtual memory. Нужна для алерта по RAM.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (application) (process_resident_memory_bytes{application=~\"$application\", app_type=~\"$app_type\"})",
          "legendFormat": "{{application}} RSS",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (application) (process_virtual_memory_bytes{application=~\"$application\", app_type=~\"$app_type\"})",
          "legendFormat": "{{application}} VIRT",
          "refId": "B"
        }
      ],
      "title": "Process memory: RSS/VIRT",
      "type": "timeseries"
    }
  ],
