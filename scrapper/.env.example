# --- Scrapper service configuration ---

# Database connection (force IPv4 to avoid localhost/IPv6 issues)
DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/link_tracker
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres

# Outbound requests to bot
BOT_BASE_URL=http://localhost:8080
BOT_TRANSPORT=HTTP
BOT_GRPC_HOST=localhost
BOT_GRPC_PORT=9090

# Scrapper scheduler
SCRAPPER_SCHEDULER_INTERVAL=30s
Invoke-RestMethod -Method PUT `
  -Uri "http://localhost:8081/tags" `
  -Headers @{ "Tg-Chat-Id" = "$chatId" } `
  -ContentType "application/json" `
  -Body (@{ link="https://github.com/octocat/Hello-World"; oldTag="important"; newTag="high-priority" } | ConvertTo-Json -Compress)
# Optional: enable scrapper gRPC server
SCRAPPER_GRPC_SERVER_ENABLED=false
SCRAPPER_GRPC_SERVER_PORT=9091

# Optional: GitHub API
GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com

# Optional: StackOverflow API
STACKOVERFLOW_KEY=
STACKOVERFLOW_ACCESS_KEY=
STACKOVERFLOW_BASE_URL=https://api.stackexchange.com/2.3
